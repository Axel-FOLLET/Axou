SECRET_KEY=change-me
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
# Address of the site, used to build the verification link sent by email.
APP_BASE_URL=http://localhost:5173
# Sending emails: 0 or absent = nothing is sent, the message is printed in the terminal.
MAIL_ENABLED=0
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=address@example.com
# App password: it is written only in .env, never here nor in the code.
SMTP_PASSWORD=change-me
MAIL_FROM=address@example.com
