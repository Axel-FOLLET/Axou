#!/usr/bin/env python3

import sys
import pygame

from functions.constants import RIGHT, WINDOW_HEIGHT, WINDOW_WIDTH
from functions.display import draw_welcome_screen, draw_end_screen, draw_game
from functions.fireworks import animate_fireworks, create_explosion
from functions.game import advance_game, new_game, step_elapsed
from functions.score import read_best_score, update_best_score
from functions.snake import choose_direction, direction_from_key


# -------------------- INITIALIZATION --------------------

# Only the display and the fonts are initialized: the game has no sound, which avoids ALSA errors.
pygame.display.init()
pygame.font.init()

window = pygame.display.set_mode((WINDOW_WIDTH, WINDOW_HEIGHT))
pygame.display.set_caption("Jeu du snake")
clock = pygame.time.Clock()

font = pygame.font.SysFont(None, 30)
large_font = pygame.font.SysFont(None, 50)
small_font = pygame.font.SysFont(None, 24)
rules_font = pygame.font.SysFont(None, 24)
end_fonts = (large_font, font, small_font)
particles = []

snake, direction, apple, score = new_game()
requested_direction = RIGHT
best_score = read_best_score()
record_broken = False
victory = False
last_step = 0
state = "welcome"
running = True


# -------------------- MAIN PROGRAM --------------------

while running:
    # Go through all the events in the queue.
    for event in pygame.event.get():

        # Handle the closing of the window.
        if event.type == pygame.QUIT:
            running = False

        # Handle the pressed keys.
        elif event.type == pygame.KEYDOWN:

            if event.key == pygame.K_ESCAPE:
                running = False

            elif state in ("welcome", "end") and event.key == pygame.K_RETURN:
                # Enter starts (or restarts) a brand new game.
                snake, direction, apple, score = new_game()
                requested_direction = direction
                particles = []
                last_step = pygame.time.get_ticks()
                state = "playing"

            elif state == "playing" and direction_from_key(event.key):
                # The U-turn is compared with the last direction actually followed.
                requested_direction = choose_direction(direction, direction_from_key(event.key))

    if state == "welcome":
        draw_welcome_screen(window, large_font, font, rules_font, small_font)

    elif state == "playing":
        now = pygame.time.get_ticks()
        if step_elapsed(last_step, now, score):
            last_step = now
            direction = requested_direction
            snake, apple, score, finished = advance_game(snake, direction, apple, score)
            if finished:
                victory = apple is None
                record_broken = update_best_score(score)
                best_score = read_best_score()
                state = "end"
                # A broken record triggers a first explosion right away.
                if record_broken:
                    particles = create_explosion(300, 200)
        draw_game(window, snake, direction, apple, score, best_score, font)

    elif state == "end":
        # The fireworks are animated only if the record has just been broken.
        if record_broken:
            particles = animate_fireworks(particles)
        draw_end_screen(window, victory, score, best_score, record_broken, particles, end_fonts)

    clock.tick(60)


pygame.quit()
sys.exit()
