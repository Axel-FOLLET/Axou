    package com.cropa.model.defense {
        abstract class Defense {
            #Defense(type : DefenseType, config : DefenseConfig)
            +getType():DefenseType
            +getLevel():int
            +getDurability():int
            +wear(percent : int):void
            +upgrade():boolean
            +canUpgrade():boolean
            +getUpgradePrice():int
            +isDestroyed():boolean
            +isAttacking():boolean
            +onDawn():void
            #getDamage():int
            #getWearPerUse():int
            #startAttackPose():void
            #countDownAttackPose(delta : float):void
            {abstract}+update(delta : float):void
            {abstract}+reaches(row : int, column : int):boolean
            {abstract}#leavePlace():void
        }
        note bottom of Defense
            What the 3 defenses share: catapatate, scarecrow, bramble.
            Level 1 to 3. upgrade: next level, durability reset to 100;
            at level 3 -> false, nothing changes. The shop reads canUpgrade and getUpgradePrice before it charges.
            Durability in % (Durability): wear lowers it; at 0, isDestroyed -> true and the defense is removed.
            On the field, the scarecrow and the bramble react through onCrossedBy when an enemy enters their cell.
            Only one wear per crossing, never stacked: on the field, the defense's own wear
            (bramble -20%, scarecrow -10%); on a slot, the enemy's wear (EnemyConfig).
            update: each defense acts at its own rate. A flying enemy triggers neither bramble nor scarecrow.
            onDawn: called on each defense at dawn; empty, except for the bramble, which grows.
            reaches: the field cells it reaches (diamond, cross, its own cell). The catapatate and the scarecrow
            choose their target with it; the view uses it to veil the range in white (OutlineRenderer.renderRange).
            leavePlace (Template Method): wear decides when to leave, each defense empties its own place.
            isAttacking (D14): true for 0.3 s after a shot or a hit; the catapatate and the scarecrow call
            startAttackPose right after their hit and countDownAttackPose at the start of update. The view then shows the attack image.
            Protected constructor: only subclasses create a defense (a plain Defense does not exist).
        end note
        class Durability {
            +wear(percent : int):void
            +reset():void
            +getPercent():int
            +isZero():boolean
        }
        note bottom of Durability
            Starts at 100 and never goes below 0. reset: back to 100 (upgrade).
        end note
        enum DefenseType {
            CATAPATATE
            SCARECROW
            BRAMBLE
        }
        note bottom of DefenseType
            Used by DefenseConfig to find the figures of each defense.
        end note
        class Catapatate {
            +Catapatate(slot : DefenseSlot, config : DefenseConfig, enemies : List<Enemy>)
            +update(delta : float):void
            +reaches(row : int, column : int):boolean
        }
        note bottom of Catapatate
            Placed on a defense slot, not on the field: it is not an Occupant.
            Range 2 cells in a diamond. 1 shot/s at the first enemy in range that can be hit;
            from the top: row 1, then row 2 if row 1 is empty; from the bottom: row 3, then row 2.
            Damage 2 / 3 / 5 by level; -2% durability per shot. "throws" image for 0.3 s after each shot (D14).
        end note
        class Scarecrow {
            +Scarecrow(cell : Cell, config : DefenseConfig, enemies : List<Enemy>)
            +update(delta : float):void
            +reaches(row : int, column : int):boolean
            +onCrossedBy(crosser : Damageable):boolean
            +onBittenByMole():boolean
            +onHarvested():OptionalInt
            +spriteKey():String
        }
        note bottom of Scarecrow
            The boxing scarecrow, placed on a field cell.
            Hits an enemy on its cell or on the 4 neighboring cells in a cross: 4 / 6 / 9, 1 hit / 1.5 s.
            Target: on the board, targetable, not flying (isFlying), the closest to the farm. A hit does not wear it.
            -10% per enemy that crosses it. Not eaten by the mole (onBittenByMole -> false).
            spriteKey: "scarecrow_attack" for 0.3 s after a hit, "scarecrow" otherwise (D14); WorldRenderer draws the key it receives.
            onHarvested -> 0 (D14): "Retirer" (Remove) frees its cell and gives nothing back, like the bramble.
        end note
        class Bramble {
            +Bramble(cell : Cell, config : DefenseConfig)
            +update(delta : float):void
            +grow():void
            +isActive():boolean
            +onDawn():void
            +reaches(row : int, column : int):boolean
            +onCrossedBy(crosser : Damageable):boolean
            +onBittenByMole():boolean
            +onHarvested():OptionalInt
            +spriteKey():String
        }
        note bottom of Bramble
            The bramble, placed on a field cell. The player picks it only in the "Défenses" (Defenses) list
            (D10, Axel's request): it is a defense (durability, levels, sting). It only reaches its own cell.
            Stings after 1 night of growth: onDawn calls grow at dawn;
            isActive -> true after that. Each enemy that crosses it: 3 / 5 / 8 damage, -20% durability.
            Not active yet: crushed like a crop. update does nothing: it only acts when an enemy passes.
            The mole does not eat it. onHarvested -> 0: "Retirer" (shop) frees the cell and earns nothing.
        end note
        enum SlotSide {
            TOP
            BOTTOM
        }
        class DefenseSlot {
            +DefenseSlot(side : SlotSide, column : int)
            +getSide():SlotSide
            +getColumn():int
            +getDefense():Optional<Defense>
            +isEmpty():boolean
            +place(defense : Defense):boolean
            +remove():void
        }
        note bottom of DefenseSlot
            A defense slot, outside the field: top1 to top5 above row 1,
            bottom1 to bottom5 below row 3 (Tiled slots layer). Columns 1 to 5.
            place: slot occupied -> false, nothing is placed (like Cell).
        end note
        class DefenseSlots {
            +getSlot(side : SlotSide, column : int):DefenseSlot
            +getDefenses():List<Defense>
            +placeOnField<D extends Defense & Occupant>(cell : Cell, defense : D):boolean
            +getDefenseOn(cell : Cell):Optional<Defense>
            +getFieldDefenses():Map<Cell,Defense>
            +wearAt(row : int, column : int, percent : int):void
        }
        note bottom of DefenseSlots
            The 10 slots, and the defenses placed on the field (map Cell -> Defense).
            wearAt (DefenseLine): row 0 -> TOP slot of the column, row 4 -> BOTTOM, any other row -> nothing.
            getDefenses: those on the slots, then those on the field, so that the game calls their update.
            placeOnField: cell occupied -> false, nothing is kept. getDefenseOn: the defense on a cell, without instanceof.
            A cell freed without notice (witch, harvest): the entry is removed at the next read.
        end note
        class DefenseOffer {
            +DefenseOffer(type : DefenseType, config : DefenseConfig, enemies : List<Enemy>, slots : DefenseSlots)
            +getType():DefenseType
            +getPrice():int
            +isPlacedOnField():boolean
            +placeOn(cell : Cell):boolean
            +placeOn(slot : DefenseSlot):boolean
        }
        note bottom of DefenseOffer
            A defense item in the shop: its price, and it creates the defense where the player clicks.
            The only place that knows Catapatate, Scarecrow and Bramble: the shop knows none of them.
            placeOn(cell): false for the catapatate or an occupied cell;
            placeOn(slot): false for the scarecrow, the bramble or an occupied slot.
        end note
        class DefenseConfig {
            +getPrice(type : DefenseType):int
            +getDamage(type : DefenseType, level : int):int
            +getCooldown(type : DefenseType):float
            +getWearPerUse(type : DefenseType):int
            +getUpgradePrice(type : DefenseType, level : int):int
            +getRange(type : DefenseType):int
            +getBrambleGrowthNights():int
        }
        note bottom of DefenseConfig
            Catapatate 150, 2/3/5, 1 shot/s, -2%, range 2, upgrades 100/200;
            scarecrow 120, 4/6/9, 1 hit/1.5 s, -10%, range 1, 80/160;
            bramble 40, 3/5/8 per crossing, -20%, 60/120, stings after 1 night.
        end note
        Defense <|-- Catapatate
        Defense <|-- Scarecrow
        Defense <|-- Bramble
        Defense *-- Durability
        Defense --> DefenseType
        DefenseSlots *-- "10" DefenseSlot
        DefenseSlot o-- "0..1" Defense
        DefenseSlot --> SlotSide
        DefenseOffer ..> Defense : creates
        DefenseOffer --> DefenseType
        DefenseOffer --> DefenseSlots
        DefenseSlots o-- "*" Defense : on the field
    }
