#!/usr/bin/env python3

import random
import pygame
import time
import unicodedata
import getpass
import sys
import datetime



# on initie notre fenêtre à afficher ainsi que le mot pour notre jeu
pygame.init()
fenetre = pygame.display.set_mode((1200, 800))
police = pygame.font.SysFont(None, 30)  # créée une seule fois, ici vu qu'elle va êtreréutilisée

from base_mots import choisir_mot

mot_a_deviner = choisir_mot()



# on définit nos fonctions utiles pour le jeu

def nettoyage(mot_a_deviner):
    mot = ""
    for letter in mot_a_deviner:
        # décompose chaque lettre accentuée en lettre de base + accent séparés
        letter_decompose = unicodedata.normalize("NFD", letter)
        for caractere in letter_decompose:
            # ne garde que les lettres de base, en minuscule
            if caractere.isalpha():
                mot += caractere.lower()
    return mot

def afficher_mot(mot, lettres_devinees):
    guess = ""
    for letter in mot:
        # affiche la lettre en majuscule si trouvée, sinon un tiret bas à la place
        if letter in lettres_devinees:
            guess += letter.upper() + " "
        else:
            guess += "_ "
    return guess

penalite = 0
lettres_tentees = set()

def entree_valide(tentative):
    # accepte uniquement du texte non vide, composé exclusivement de lettres
    return len(tentative) > 0 and tentative.isalpha()

max_penalites = 12

def traiter_lettre(tentative):
    # gère le cas d'une lettre unique : déjà tentée, trouvée dans le mot, ou pénalité si absente
    global penalite
    if tentative in lettres_tentees:
        print("VOUS AVEZ DÉJÀ TENTÉ CETTE LETTRE, VEUILLEZ EN PROPOSER UNE AUTRE.")
        return
    lettres_tentees.add(tentative)
    if tentative in mot:
        lettres_devinees.add(tentative)
    else:
        penalite += 1

def traiter_mot_complet(tentative):
    # gère le cas d'un mot complet proposé : victoire si correct, sinon pénalité de 5
    global penalite
    if tentative == mot:
        return True
    penalite += 5
    return False

nombre_tentatives = 0

def points(tentative):
    global nombre_tentatives
    # aiguille la tentative vers le bon traitement, selon sa validité et sa longueur
    if not entree_valide(tentative):
        print("ENTRÉE INVALIDE, VEUILLEZ PROPOSER UNE LETTRE OU UN MOT.")
        return False
    #si l'entrée est valide, on compte la tentative pour le score et on l'envoie vers le bon traitement
    nombre_tentatives += 1
    if len(tentative) == 1:
        traiter_lettre(tentative)
        return False
    return traiter_mot_complet(tentative)

def dessiner_segments_si_penalite(fenetre, couleur, segments, penalite):
    # parcourt une liste de segments (seuil, point de départ, point d'arrivée)
    # ne dessine que ceux dont le seuil de pénalité est déjà atteint
    for seuil, depart, arrivee in segments:
        if penalite >= seuil:
            pygame.draw.line(fenetre, couleur, depart, arrivee, 5)

def etabli_de_pendaison(fenetre, penalite):
    gris_clair = (200, 200, 200)
    # notre liste définit : à partir de quelle pénalité ce segment apparaît, et ses coordonnées de début/fin
    segments = [
        (1, (150, 500), (250, 500)),
        (2, (250, 500), (350, 500)),
        (3, (200, 500), (200, 100)),
        (4, (200, 100), (300, 100)),
        (5, (200, 130), (240, 100)),
        (6, (300, 100), (300, 150)),
    ]
    dessiner_segments_si_penalite(fenetre, gris_clair, segments, penalite)

def dessiner_homme_baton(fenetre, penalite):
    couleur = (128, 0, 32)
    # la tête est traitée à part car c'est un cercle, pas une ligne droite comme les autres membres
    if penalite >= 7:
        pygame.draw.circle(fenetre, couleur, (300, 200), 50, 5)
    # notre liste définit ici aussi : à partir de quelle pénalité ce segment apparaît, et ses coordonnées de début/fin
    segments = [
        (8, (300, 250), (300, 400)),
        (9, (300, 250), (250, 300)),
        (10, (300, 250), (350, 300)),
        (11, (300, 400), (250, 450)),
        (12, (300, 400), (350, 450)),
    ]
    dessiner_segments_si_penalite(fenetre, couleur, segments, penalite)

def afficher_lettres_echouees(fenetre, lettres_tentees, mot):
    # affiche, en texte, les lettres tentées qui ne sont pas dans le mot
    lettres_echouees = ""
    for lettre in lettres_tentees:
        if lettre not in mot:
            lettres_echouees += lettre.upper() + " "
    texte = police.render("Lettres échouées : " + lettres_echouees, True, (0, 0, 0))
    fenetre.blit(texte, (50, 50))

def afficher_lettres_trouvees(fenetre, lettres_devinees, mot):
    # réutilise afficher_mot() pour éviter de dupliquer la même logique d'affichage
    texte = police.render("Lettres trouvées : " + afficher_mot(mot, lettres_devinees), True, (0, 0, 0))
    fenetre.blit(texte, (50, 650))

def rafraichir_ecran(fenetre, penalite, lettres_tentees, mot):
    # efface l'écran puis redessine tout l'état actuel du jeu
    fenetre.fill((255, 255, 255))
    etabli_de_pendaison(fenetre, penalite)
    dessiner_homme_baton(fenetre, penalite)
    afficher_lettres_echouees(fenetre, lettres_tentees, mot)
    afficher_lettres_trouvees(fenetre, lettres_devinees, mot)
    pygame.display.flip()

mot = nettoyage(mot_a_deviner)
lettres_devinees = set()

def lire_meilleur_score():
    # tente de lire le fichier de score existant, renvoie None si aucune partie n'a encore été gagnée
    try:
        with open("meilleur_score.txt") as fichier:
            contenu = fichier.readline()
    except FileNotFoundError:
        contenu = None
    return contenu

def meilleur_score_battu(contenu, nombre_tentatives):
    # un score inexistant est toujours battu ; sinon, compare le nombre de tentatives (plus petit = meilleur)
    if contenu is None:
        return True
    # une erreur s'est glissée dans le fichier de score, on considère que le score est battu pour ne pas bloquer le jeu
    try:
        ancien_score = int(contenu.split()[0])
    except (ValueError, IndexError):
        return True
    return nombre_tentatives < ancien_score

def afficher_meilleur_score(nombre_tentatives):
    # compare avec le record existant et affiche le message adapté (nouveau record ou score non battu)
    contenu = lire_meilleur_score()
    if meilleur_score_battu(contenu, nombre_tentatives):
        print("FÉLICITATIONS ! VOUS AVEZ BATTU LE MEILLEUR SCORE !")
    else:
        ancien_score = int(contenu.split()[0])
        ancienne_date = contenu.split()[1]
        print(f"LE MEILLEUR SCORE EST DE {ancien_score} TENTATIVES LE {ancienne_date}. VOUS N'AVEZ PAS BATU CE SCORE.")

def enregistrer_score(nombre_tentatives):
    date_aujourdhui = datetime.date.today()
    with open("meilleur_score.txt", "w") as fichier:
        fichier.write(str(nombre_tentatives) + " " + str(date_aujourdhui))



# rafraîchit l'écran pour la première fois, avant que le joueur ne commence à jouer, affin de ne pas afficher un écran vide
rafraichir_ecran(fenetre, penalite, lettres_tentees, mot)

print("\n________________________________________________________ \n \n \nBIENVENUE AU JEU DU PENDU, TROUVEZ LE MOT SECRET POUR SURVIVRE !\n \nATTENTION !\nSEULES " + str(max_penalites) + " ERREURS VOUS SERONT PERMISES. \nUNE MAUVAISE LETTRE VOUS COÛTERA 1 PENALITE, MAIS UN MOT COMPLET ERRONÉ VOUS EN COÛTERA 5 ! \nLE MOT A DEVINER A " + str(len(mot)) + " LETTRE(S). \nPUISSE LE SORT VOUS ÊTRE FAVORABLE. \n")

while True:
    print("\n" + afficher_mot(mot, lettres_devinees) + "\n \nVOS PÉNALITÉS SONT AU NOMBRE DE : " + str(penalite) + "/" + str(max_penalites) + " ; ATTENTION, IL VOUS RESTE " + str(max_penalites - penalite) + " CHANCES !" "\n \n________________________________________________________ \n")
    tentative = input("JOUEUR, PROPOSEZ UNE LETTRE OU UN MOT COMPLET : ")
    tentative_nettoyee = nettoyage(tentative)
    victoire = points(tentative_nettoyee)
    # après chaque tentative, on redessine tout l'écran pour refléter le nouvel état (pénalités, lettres échouées)
    rafraichir_ecran(fenetre, penalite, lettres_tentees, mot)
    if victoire or set(mot) == lettres_devinees:
        afficher_meilleur_score(nombre_tentatives)
        if meilleur_score_battu(lire_meilleur_score(), nombre_tentatives):
            enregistrer_score(nombre_tentatives)    
        print("\n \nVOUS REMPORTEZ LA PARTIE ! VOUS OBTENEZ LE DROIT DE SURVIVRE. \nLE MOT À DEVINER ÉTAIT : " + mot_a_deviner.upper())
        break
    if penalite >= max_penalites:
        afficher_meilleur_score(nombre_tentatives)
        print("\n \nLE SORT VOUS A ÉTÉ DÉFAVORABLE, VOUS ALLEZ ÊTRE PENDU, DEFAITE. \nLE MOT À DEVINER ÉTAIT : " + mot_a_deviner.upper())
        break

    # vérifie si l'utilisateur a cliqué sur la croix pour fermer la fenêtre pygame
    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            sys.exit()

pygame.quit()