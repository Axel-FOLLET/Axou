#!/usr/bin/env python3

question = input("Souhaitez vous CRYPTER ou DECRYPTER selon Vigenère : ")

if question == "CRYPTER":
    message = input("Votre message à crypter selon Vigenère : ")
    clef = input("Donnez votre clef de cryptage : ")
    resultat = ""
    compteur_de_lettre = 0
    for lettre in message.lower():
        if lettre.isalpha():
            lettre_cle = clef[compteur_de_lettre % len(clef)]
            decalage = ord(lettre_cle) - ord('a')
            resultat += chr((ord(lettre) - ord('a') + decalage) % 26 + ord('a'))
            compteur_de_lettre += 1
        else:
            resultat += lettre
    print(resultat)

elif question == "DECRYPTER":
    message = input("Votre message à décrypter selon Vigenère : ")
    clef = input("Donnez votre clef de cryptage : ")
    resultat = ""
    compteur_de_lettre = 0
    for lettre in message.lower():
        if lettre.isalpha():
            lettre_cle = clef[compteur_de_lettre % len(clef)]
            decalage = ord(lettre_cle) - ord('a')
            resultat += chr((ord(lettre) - ord('a') - decalage) % 26 + ord('a'))
            compteur_de_lettre += 1
        else:
            resultat += lettre
    print(resultat)
