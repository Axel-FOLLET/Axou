#!/usr/bin/env python3

texte = int(input("Please give me a number, I will give you a category: "))

def categorize_numbers(texte):
    trouve = False
    if texte == 42:
        print("a")
        trouve = True
    if texte <= 21:
        print("b")
        trouve = True
    if texte % 2 == 0:
        print("c")
        trouve = True
    if texte / 2 < 21:
        print("d")
        trouve = True
    if texte % 2 != 0 and texte >= 45:
        print("e")
        trouve = True
    if trouve == False:
        print("f")

categorize_numbers(texte)
