#!/usr/bin/env python3

texte = int(input("Please give me a number, I will give you a category: "))

def categorize_numbers(texte):
    if texte == 42:
        print("a")
    elif texte <= 21:
        print("b")
    elif texte % 2 == 0:
        print("c")
    elif texte / 2 < 21:
        print("d")
    elif texte % 2 != 0 and texte >= 45:
        print("e")
    else:
        print("f")

categorize_numbers(texte)
