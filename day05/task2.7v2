#!/usr/bin/env python3

types_pokemons = {"Electric": ["Pikachu"], "Grass": ["Bulbasaur", "Leafeon"], "Fire": ["Charmander", "Scovillain"]}

pokemon_vers_type = {}
for key in types_pokemons:
    for pokemon in types_pokemons[key]:
        pokemon_vers_type[pokemon] = key

print(pokemon_vers_type["Pikachu"])