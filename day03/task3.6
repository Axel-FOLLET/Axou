}

def enlever_accents(texte):
    texte_decompose = unicodedata.normalize("NFD", texte)
    resultat = ""
    for caractere in texte_decompose:
        if caractere.isalpha() or caractere == " ":
            resultat = resultat + caractere
    return resultat

def comparaison(pourcentages_texte, pourcentages_langue):
    difference_totale = 0
    for lettre in pourcentages_texte:
        pourcentage_texte = pourcentages_texte[lettre]
        pourcentage_langue = pourcentages_langue.get(lettre, 0)
        difference_totale = difference_totale + abs(pourcentage_texte - pourcentage_langue)
    return difference_totale

texte = input("Donne un texte : ")
texte = texte.lower()
texte = enlever_accents(texte)

compteur = {}
longueur_totale = 0
for lettre in texte:
    if lettre.isalpha():
        longueur_totale = longueur_totale + 1
        if lettre in compteur:
            compteur[lettre] = compteur[lettre] + 1
        else:
            compteur[lettre] = 1

pourcentages_texte = {}
for lettre in compteur:
    pourcentages_texte[lettre] = (compteur[lettre] / longueur_totale) * 100

meilleure_langue = ""
meilleur_score = None
for nom_langue, pourcentages_langue in langues.items():
    score = comparaison(pourcentages_texte, pourcentages_langue)
    if meilleur_score is None or score < meilleur_score:
        meilleur_score = score
        meilleure_langue = nom_langue

print("La langue est probablement : " + meilleure_langue)
