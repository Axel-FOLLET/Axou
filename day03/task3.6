    "Spanish": {"e":13,"a":13,"i":8,"n":7,"o":9,"r":7,"s":8,"t":5,"l":5,"d":5,"u":3,"m":3,"c":4,"p":3,"g":2,"b":2},
    "Portuguese": {"e":13,"a":15,"i":7,"n":5,"o":10,"r":7,"s":7,"t":4,"l":3,"d":5,"u":4,"m":5,"c":4,"p":3,"h":1,"g":1},
    "Italian": {"e":12,"a":12,"i":10,"n":7,"o":10,"r":6,"s":5,"t":6,"l":6,"d":4,"u":3,"m":2,"c":4,"p":3,"h":1,"g":2},
    "French": {"e":15,"a":8,"i":8,"n":7,"o":6,"r":7,"s":8,"t":7,"l":5,"d":4,"u":6,"m":3,"c":3,"p":2,"v":2,"f":1},
    "English": {"e":13,"a":8,"i":7,"n":7,"o":7,"r":6,"s":6,"t":9,"l":4,"d":4,"u":3,"m":2,"c":3,"p":2,"h":6,"g":2},
    "German": {"e":16,"a":6,"i":6,"n":10,"o":3,"r":7,"s":7,"t":6,"l":3,"d":5,"u":4,"m":2,"c":3,"h":5,"g":3,"k":1},
