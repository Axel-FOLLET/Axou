#!/usr/bin/env python3

import turtle
turtle.shape("turtle")
turtle.color("pink")

sides = int(input("Donnez un nombre de faces : "))

def calcul_angle(sides):
    return 360 / sides # un tour complet (360°) réparti entre tous les sommets du polygone

def draw_polygon(sides):
    angle = calcul_angle(sides)
    for _ in range(sides):
        turtle.forward(100)
        turtle.right(angle)

draw_polygon(sides)
turtle.exitonclick()