#!/usr/bin/env python3

def bread():
    print("<//////////>")
def lettuce():
    print("~~~~~~~~~~~~")
def tomato():
    print("O O O O O O")
def ham():
    print("============")

def sandwiches():
    bread()
    tomato()
    ham()
    ham()
    lettuce()
    bread()

nombre = input("Donnez un nombre de sandwiches : ")

if nombre.isdigit() == False :
    print("I can't do this!")
else:
    for _ in range(int(nombre)):
        sandwiches()
        print()