#!/usr/bin/env python3

def bread():
    print("<//////////>")
def lettuce():
    print("~~~~~~~~~~~~")
def tomato():
    print("O O O O O O")
def ham():
    print("============")

def sandwiches():
    bread()
    tomato()
    ham()
    ham()
    lettuce()
    bread()

def veg_sandwiches():
    bread()
    tomato()
    lettuce()
    tomato()
    lettuce()
    bread()

nombre = input("Donnez un nombre de sandwiches, si vous le voulez végératien faites une espace et dites veg : ")
donnees = nombre.split(" ")
if donnees[0].isdigit() == False :
    print("I can't do this!")
elif len(donnees) > 1 and donnees[1] == "veg":    
