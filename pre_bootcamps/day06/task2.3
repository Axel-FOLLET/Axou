#!/usr/bin/env python3
import os

def parcourir_dossier(chemin):
    print(chemin)
    for element in os.listdir(chemin):
        chemin_complet = os.path.join(chemin, element)
        if os.path.isdir(chemin_complet):
            parcourir_dossier(chemin_complet)
        else:
            print(chemin_complet)

parcourir_dossier(".")