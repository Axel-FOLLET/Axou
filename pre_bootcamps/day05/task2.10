#!/usr/bin/env python3

superheroes = {
    "Batman": {
        "id": 1,
        "aliases": ["Bruce Wayne", "Dark knight", "Caped Crusader"],
        "location": {"number": 1007, "street": "Mountain Drive", "city": "Gotham"}
    },
    "Superman": {
        "id": 2,
        "aliases": ["Kal-El", "Clark Kent", "The Man of Steel"],
        "location": {"number": 344, "street": "Clinton Street", "apartment": "3D", "city": "Metropolis"}
    },
    "Wolverine": {
        "id": 3
    }
}

for heros in superheroes:
    print(heros)
    if "aliases" in superheroes[heros]:
        for alias in superheroes[heros]["aliases"]:
            print(alias)
    else:
        print("No aliases found")
    print()