#!/usr/bin/env python3

def nettoyer(texte):
    resultat = ""
    for donnees in texte.lower():
        if donnees.isalpha():
            resultat += donnees
    return resultat

def palindrome(texte):
    if len(texte) <= 1:
        return True
    if texte[0] != texte[-1]:
        return False
    return palindrome(texte[1:-1])

print(palindrome(nettoyer("Never odd or even")))
print(palindrome(nettoyer("A Santa Lived As a Devil at NASA")))