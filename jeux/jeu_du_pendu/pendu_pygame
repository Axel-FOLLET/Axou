#!/usr/bin/env python3

import os
import sys

sys.dont_write_bytecode = True
os.environ.setdefault("SDL_AUDIODRIVER", "dummy")

import datetime
import unicodedata
import pygame

from base_mots import choisir_mot


# -------------------- INITIALISATION --------------------

pygame.init()

fenetre = pygame.display.set_mode((1200, 800))
pygame.display.set_caption("Jeu du pendu")

police = pygame.font.SysFont(None, 30)
grande_police = pygame.font.SysFont(None, 50)
petite_police = pygame.font.SysFont(None, 24)

BLANC = (255, 255, 255)
NOIR = (0, 0, 0)
GRIS = (200, 200, 200)
MARRON = (101, 67, 33)
ROUGE = (180, 0, 0)
VERT = (0, 130, 0)
ORANGE = (240, 150, 0)
VERT_CLAIR = (170, 225, 170)
ROUGE_CLAIR = (240, 150, 150)
FOND_MESSAGE = (255, 235, 235)
FOND_VICTOIRE = (215, 245, 215)
FOND_DEFAITE = (250, 215, 215)

max_penalites = 12

LIGNES_CLAVIER = ["AZERTYUIOP", "QSDFGHJKLM", "WXCVBN"]
TOUCHE_LARGEUR = 46
TOUCHE_HAUTEUR = 50
TOUCHE_ECART = 8
CLAVIER_X = 620
CLAVIER_LARGEUR = 532
CLAVIER_Y = 250


# -------------------- MOT --------------------

mot_a_deviner = choisir_mot()
mot = ""


def nettoyage(texte):
    #Supprime les accents et met le texte en minuscule.
    texte_nettoye = ""
    for lettre in texte:
        lettre_decomposee = unicodedata.normalize("NFD", lettre)
        for caractere in lettre_decomposee:
            if caractere.isalpha():
                texte_nettoye += caractere.lower()
    return texte_nettoye

mot = nettoyage(mot_a_deviner)


# -------------------- JEU --------------------

penalite = 0
nombre_tentatives = 0
lettres_tentees = set()
lettres_devinees = set()


def entree_valide(tentative):
    #Vérifie que la saisie contient uniquement des lettres.
    return len(tentative) > 0 and tentative.isalpha()


def afficher_mot(mot, lettres_devinees):
    #Retourne le mot avec les lettres trouvées et les lettres cachées.
    affichage = ""
    for lettre in mot:
        if lettre in lettres_devinees:
            affichage += lettre.upper() + " "
        else:
            affichage += "_ "
    return affichage


#Définition des pénalités :
def traiter_lettre(tentative):
    #Traite une tentative composée d'une seule lettre.
    global penalite
    lettres_tentees.add(tentative)
    if tentative in mot:
        lettres_devinees.add(tentative)
        return True
    penalite += 1
    return False


def traiter_mot_complet(tentative):
    #Traite une tentative composée d'un mot complet.
    global penalite
    if tentative == mot:
        return True
    penalite += 5
    return False


#Le reste :
def traiter_tentative(tentative):
    #Traite une tentative et retourne le résultat.
    global nombre_tentatives

    if not entree_valide(tentative):
        return "invalide"
    nombre_tentatives += 1

    if len(tentative) == 1:
        if tentative in lettres_tentees:
            return "deja_tentee"
        traiter_lettre(tentative)
        return "ok"

    if traiter_mot_complet(tentative):
        return "victoire"
    return "ok"


def mot_trouve():
    #Vérifie si toutes les lettres du mot ont été trouvées.
    return set(mot) == lettres_devinees


# -------------------- PENDU --------------------

def dessiner_segments(fenetre, couleur, segments):
    #Dessine les segments dont la pénalité est atteinte, évite les if à répétition, grâce à une liste.
    for seuil, depart, arrivee in segments:
        if penalite >= seuil:
            pygame.draw.line(fenetre, couleur, depart, arrivee, 5)


def dessiner_potence(fenetre):
    #Dessine la potence progressivement.
    segments = [
        (1, (150, 500), (250, 500)),
        (2, (250, 500), (350, 500)),
        (3, (200, 500), (200, 100)),
        (4, (200, 100), (300, 100)),
        (5, (200, 130), (240, 100)),
        (6, (300, 100), (300, 150)),
    ]
    dessiner_segments(fenetre, MARRON, segments)


def dessiner_homme(fenetre):
    #Dessine le personnage progressivement.
    if penalite >= 7:
        pygame.draw.circle(fenetre, ROUGE, (300, 200), 50, 5)
    segments = [
        (8, (300, 250), (300, 400)),
        (9, (300, 260), (250, 310)),
        (10, (300, 260), (350, 310)),
        (11, (300, 400), (250, 450)),
        (12, (300, 400), (350, 450)),
    ]
    dessiner_segments(fenetre, ROUGE, segments)


# -------------------- AFFICHAGE --------------------

def afficher_texte(texte, position, police_utilisee=police, couleur=NOIR):
    #Affiche un texte dans la fenêtre.
    surface = police_utilisee.render(texte, True, couleur)
    fenetre.blit(surface, position)


def afficher_centre(texte, y, police_utilisee=police, couleur=NOIR):
    #Affiche un texte centré horizontalement.
    surface = police_utilisee.render(texte, True, couleur)
    x = (fenetre.get_width() - surface.get_width()) // 2
    fenetre.blit(surface, (x, y))


def couleur_touche(lettre):
    #Blanc si non tentée, vert si dans le mot, rouge sinon.
    if lettre not in lettres_tentees:
        return BLANC
    if lettre in mot:
        return VERT_CLAIR
    return ROUGE_CLAIR


def afficher_clavier():
    #Affiche les 26 lettres en clavier AZERTY, colorées selon les tentatives.
    for numero_ligne, ligne in enumerate(LIGNES_CLAVIER):
        largeur_ligne = len(ligne) * (TOUCHE_LARGEUR + TOUCHE_ECART) - TOUCHE_ECART
        x_depart = CLAVIER_X + (CLAVIER_LARGEUR - largeur_ligne) // 2
        y = CLAVIER_Y + numero_ligne * (TOUCHE_HAUTEUR + TOUCHE_ECART)
        for numero, lettre in enumerate(ligne):
            touche = pygame.Rect(x_depart + numero * (TOUCHE_LARGEUR + TOUCHE_ECART), y, TOUCHE_LARGEUR, TOUCHE_HAUTEUR)
            pygame.draw.rect(fenetre, couleur_touche(lettre.lower()), touche, border_radius=8)
            pygame.draw.rect(fenetre, GRIS, touche, 2, border_radius=8)
            surface = police.render(lettre, True, NOIR)
            fenetre.blit(surface, surface.get_rect(center=touche.center))


def afficher_lettres_trouvees():
    #Affiche les lettres déjà trouvées.
    afficher_texte("Mot : " + afficher_mot(mot, lettres_devinees), (50, 650), grande_police)


def couleur_barre(rapport):
    #Vert au début, orange au milieu, rouge quand la pendaison approche.
    if rapport < 1 / 3:
        return VERT
    if rapport < 2 / 3:
        return ORANGE
    return ROUGE


def afficher_barre_penalites(x, y, largeur, hauteur):
    #Dessine une barre qui se remplit à chaque pénalité.
    rapport = min(penalite / max_penalites, 1)
    fond = pygame.Rect(x, y, largeur, hauteur)
    pygame.draw.rect(fenetre, GRIS, fond, border_radius=10)
    if rapport > 0:
        rempli = pygame.Rect(x, y, int(largeur * rapport), hauteur)
        pygame.draw.rect(fenetre, couleur_barre(rapport), rempli, border_radius=10)
    pygame.draw.rect(fenetre, NOIR, fond, 2, border_radius=10)


def afficher_penalites():
    #Affiche le nombre de pénalités subies avec sa barre, puis les chances restantes.
    afficher_texte(f"Pénalités : {penalite}/{max_penalites}", (620, 50))
    afficher_barre_penalites(620, 85, CLAVIER_LARGEUR, 26)
    afficher_texte(f"Chances restantes : {max(max_penalites - penalite, 0)}", (620, 130), police, ROUGE)
    afficher_texte(f"Tentatives : {nombre_tentatives}", (620, 165), police, GRIS)


def afficher_saisie(saisie):
    #Affiche un champ de saisie avec un curseur clignotant.
    afficher_texte("Votre proposition :", (50, 708), police)
    champ = pygame.Rect(260, 695, 400, 42)
    pygame.draw.rect(fenetre, BLANC, champ, border_radius=8)
    pygame.draw.rect(fenetre, MARRON, champ, 3, border_radius=8)
    surface = police.render(saisie.upper(), True, NOIR)
    fenetre.blit(surface, (champ.x + 12, champ.y + 12))
    if (pygame.time.get_ticks() // 500) % 2 == 0:
        x_curseur = champ.x + 14 + surface.get_width()
        pygame.draw.line(fenetre, NOIR, (x_curseur, champ.y + 8), (x_curseur, champ.bottom - 8), 2)


def afficher_message(message, couleur=NOIR):
    #Affiche un message centré dans un cadre coloré.
    surface = police.render(message, True, couleur)
    cadre = surface.get_rect(center=(fenetre.get_width() // 2, 605)).inflate(40, 20)
    pygame.draw.rect(fenetre, FOND_MESSAGE, cadre, border_radius=10)
    pygame.draw.rect(fenetre, couleur, cadre, 2, border_radius=10)
    fenetre.blit(surface, surface.get_rect(center=cadre.center))


def rafraichir_ecran(saisie="", message=""):
    #Efface l'écran.
    fenetre.fill(BLANC)
    #Puis on redessine tout ce qui doit être affiché à l'écran.
    dessiner_potence(fenetre)
    dessiner_homme(fenetre)
    afficher_clavier()
    afficher_lettres_trouvees()
    afficher_penalites()
    afficher_saisie(saisie)

    if message:
        afficher_message(message, ROUGE)

    pygame.display.flip()


# -------------------- SCORE --------------------

CHEMIN_SCORE = os.path.join(os.path.dirname(__file__), "meilleur_score.txt")

def lire_meilleur_score():
    #Lit le meilleur score enregistré dans le fichier, évite les erreurs si le fichier n'existe pas.
    try:
        with open(CHEMIN_SCORE) as fichier:
            return fichier.readline().strip()
    except FileNotFoundError:
        return None


def meilleur_score_battu(contenu):
    #Vérifie si le score actuel est meilleur que l'ancien.
    if contenu is None:
        return True
    #Ici aussi, on gère les cas où le contenu du fichier est vide ou mal formaté.
    try:
        ancien_score = int(contenu.split()[0])
    except (ValueError, IndexError):
        return True
    return nombre_tentatives < ancien_score


def enregistrer_score():
    #Enregistre le nouveau meilleur score (w nous permet d'écraser le fichier existant).
    date_aujourdhui = datetime.date.today()
    with open(CHEMIN_SCORE, "w") as fichier:
        fichier.write(str(nombre_tentatives) + " " + str(date_aujourdhui))


def texte_meilleur_score(victoire):
    #Retourne le texte du meilleur score, et l'enregistre seulement en cas de victoire.
    contenu = lire_meilleur_score()

    if victoire and meilleur_score_battu(contenu):
        enregistrer_score()
        return "FÉLICITATIONS ! NOUVEAU MEILLEUR SCORE !"

    if contenu is None:
        return "Aucun meilleur score enregistré."

    ancien_score = contenu.split()[0]
    ancienne_date = contenu.split()[1]
    return (
        f"Meilleur score : {ancien_score} tentative(s) "
        f"le {ancienne_date}."
    )


# -------------------- ÉCRAN D'ACCUEIL --------------------

def dessiner_logo_pendu(centre_x, haut):
    #Dessine une petite potence avec sa corde et son nœud coulant.
    gauche = centre_x - 30
    bas = haut + 70
    pygame.draw.line(fenetre, MARRON, (gauche - 15, bas), (gauche + 45, bas), 5)
    pygame.draw.line(fenetre, MARRON, (gauche, bas), (gauche, haut), 5)
    pygame.draw.line(fenetre, MARRON, (gauche, haut), (gauche + 50, haut), 5)
    pygame.draw.line(fenetre, MARRON, (gauche, haut + 20), (gauche + 20, haut), 4)
    pygame.draw.line(fenetre, NOIR, (gauche + 50, haut), (gauche + 50, haut + 22), 3)
    pygame.draw.circle(fenetre, ROUGE, (gauche + 50, haut + 32), 10, 3)


def afficher_accueil():
    #Affiche l'écran d'accueil avec les instructions du jeu dans un cadre.
    fenetre.fill(BLANC)
    dessiner_logo_pendu(fenetre.get_width() // 2, 25)
    afficher_centre("BIENVENUE AU JEU DU PENDU", 120, grande_police)
    afficher_centre("Trouvez le mot secret pour survivre !", 190)
    pygame.draw.rect(fenetre, MARRON, (300, 245, 600, 205), 4, border_radius=14)
    afficher_centre(f"Vous avez droit à {max_penalites} pénalités.", 270)
    afficher_centre("Une mauvaise lettre coûte 1 pénalité.", 320)
    afficher_centre("Un mot complet incorrect coûte 5 pénalités.", 360)
    afficher_centre(f"Le mot contient {len(mot)} lettre(s).", 410)
    afficher_centre("Appuyez sur ENTRÉE pour commencer.", 520, police, VERT)
    afficher_centre("ÉCHAP pour quitter.", 570, petite_police)

    pygame.display.flip()


# -------------------- ÉCRAN DE FIN --------------------

def afficher_fin(victoire, texte_score):
    #Affiche l'écran de victoire ou de défaite, avec la potence dans l'état final.
    fenetre.fill(FOND_VICTOIRE if victoire else FOND_DEFAITE)

    #La potence est dessinée sur une surface transparente, puis décalée à gauche du texte.
    dessin = pygame.Surface((400, 520), pygame.SRCALPHA)
    dessiner_potence(dessin)
    dessiner_homme(dessin)
    fenetre.blit(dessin, (-100, 130))

    if victoire:
        afficher_centre("VOUS REMPORTEZ LA PARTIE !", 150, grande_police, VERT)
        afficher_centre("Vous obtenez le droit de survivre.", 230)
        afficher_centre(texte_score, 310)

    else:
        afficher_centre("DÉFAITE", 150, grande_police, ROUGE)
        afficher_centre("Le sort vous a été défavorable.", 230)
        afficher_centre("Vous allez être pendu.", 280)
        afficher_centre(texte_score, 350)

    afficher_centre("Le mot était : " + mot_a_deviner.upper(), 450)
    afficher_centre("Appuyez sur ÉCHAP pour quitter.", 550, petite_police)
    pygame.display.flip()


# -------------------- ÉVÉNEMENTS --------------------

def gerer_saisie(event, saisie):
    #Modifie la saisie en fonction de la touche pressée.
    if event.key == pygame.K_BACKSPACE:
        return saisie[:-1]

    if event.unicode.isalpha():
        return saisie + event.unicode
    return saisie


# -------------------- PROGRAMME PRINCIPAL --------------------

etat = "accueil"
saisie = ""
message = ""
fin_message = 0
texte_score = None
victoire = False
jeu_actif = True

while jeu_actif:
#On parcourt tous les événements de la file d'attente.
    for event in pygame.event.get():

        #On gère la fermeture de la fenêtre.
        if event.type == pygame.QUIT:
            jeu_actif = False

        #On gère les touches pressées.
        elif event.type == pygame.KEYDOWN:

            if event.key == pygame.K_ESCAPE:
                jeu_actif = False

            elif etat == "accueil":
                if event.key == pygame.K_RETURN:
                    etat = "jeu"

            elif etat == "jeu":
                #On gère la saisie de l'utilisateur.
                
                if event.key == pygame.K_RETURN:
                    tentative_nettoyee = nettoyage(saisie)
                    resultat = traiter_tentative(tentative_nettoyee)

                    saisie = ""
                    message = ""

                    if resultat == "invalide":
                        message = "ENTRÉE INVALIDE. ENTREZ UNE LETTRE OU UN MOT."
                        fin_message = pygame.time.get_ticks() + 3000

                    elif resultat == "deja_tentee":
                        message = "CETTE LETTRE A DÉJÀ ÉTÉ TENTÉE."
                        fin_message = pygame.time.get_ticks() + 3000

                    elif resultat == "victoire":
                        victoire = True
                        etat = "fin"

                    elif mot_trouve():
                        victoire = True
                        etat = "fin"

                    elif penalite >= max_penalites:
                        victoire = False
                        etat = "fin"

                else:
                    saisie = gerer_saisie(event, saisie)

    if etat == "accueil":
        afficher_accueil()

    elif etat == "jeu":
        #Le message disparaît au bout de 3 secondes.
        if message and pygame.time.get_ticks() > fin_message:
            message = ""
        rafraichir_ecran(saisie, message)

    elif etat == "fin":
        #Le score n'est calculé (et enregistré) qu'une seule fois.
        if texte_score is None:
            texte_score = texte_meilleur_score(victoire)
        afficher_fin(victoire, texte_score)


pygame.quit()
sys.exit()