SECRET_KEY=change-me
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
# Adresse du site, utilisée pour construire le lien de vérification envoyé par email.
APP_BASE_URL=http://localhost:5173
# Envoi des emails : 0 ou absent = rien n'est envoyé, le message s'affiche dans le terminal.
MAIL_ENABLED=0
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=adresse@example.com
# Mot de passe d'application : il n'est écrit que dans .env, jamais ici ni dans le code.
SMTP_PASSWORD=change-me
MAIL_FROM=adresse@example.com
